// roBa keymap: Windows=BT 0, macOS=BT 1
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
    tapping-term-ms = <200>;
};

&trackball {
    automouse-layer = <6>;
    scroll-layers = <7>;

    // arrows {
    //     layers = <5>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        mac_arrow {
            if-layers = <2 5>;
            then-layer = <9>;
        };

        windows_window {
            if-layers = <1 8>;
            then-layer = <10>;
        };

        mac_window {
            if-layers = <2 8>;
            then-layer = <11>;
        };
    };

    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };

    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        select_windows: select_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&bt BT_SEL 0>, <&to 1>;
            label = "SELECT_WINDOWS";
        };

        select_mac: select_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&bt BT_SEL 1>, <&to 2>;
            label = "SELECT_MAC";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        lt_scroll: lt_scroll {
            compatible = "zmk,behavior-hold-tap";
            flavor = "tap-preferred";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        win_alt_e: win_alt_e {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp E>, <&kp LA(F4)>;
            mods = <(MOD_LALT | MOD_RALT)>;
        };

        mac_alt_e: mac_alt_e {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp E>, <&kp LC(Q)>;
            mods = <(MOD_LALT | MOD_RALT)>;
        };

        win_gui_w: win_gui_w {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp W>, <&kp LG(TAB)>;
            mods = <(MOD_LGUI | MOD_RGUI)>;
        };

        mac_gui_w: mac_gui_w {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp W>, <&kp LG(UP_ARROW)>;
            mods = <(MOD_LGUI | MOD_RGUI)>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt ESCAPE Q      &kp W         &kp E         &kp R                   &kp T                                                   &kp Y        &kp U  &kp I      &kp O                &lt_scroll 7 P
&kp A             &kp S         &kp D         &kp F                   &kp G        &kp LS(LG(S))               &kp MINUS      &kp H        &kp J  &kp K      &kp L                &kp SINGLE_QUOTE
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                   &kp B        &kp COLON                   &kp SEMICOLON  &kp N        &kp M  &kp COMMA  &mt RIGHT_SHIFT DOT  &kp SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt_to_layer_0 8 LANG2  &lt 4 SPACE  &lt_to_layer_0 5 LANG1      &kp BACKSPACE  &lt 3 ENTER                                         &kp DEL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        WINDOWS {
            bindings = <
&trans  &win_gui_w  &win_alt_e  &trans  &trans                              &trans  &trans  &trans  &trans  &trans
&trans  &trans      &trans      &trans  &trans  &kp LS(LG(S))      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans      &trans      &trans  &trans  &trans             &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans      &trans      &lt 8 LANG2  &trans  &lt 5 LANG1  &trans  &trans                          &trans
            >;
        };

        MAC {
            bindings = <
&trans  &mac_gui_w  &mac_alt_e  &trans  &trans                               &trans  &trans  &trans  &trans  &trans
&trans  &trans      &trans      &trans  &trans  &kp LS(LG(S))       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans      &trans      &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans      &trans      &lt 8 LANG2  &trans  &lt 5 LANG1  &trans  &trans                          &trans
            >;
        };

        layer_1 {
            bindings = <
&trans                &kp AMPERSAND  &kp ASTRK    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                         &trans         &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp UNDER      &trans
&kp GRAVE             &kp DOLLAR     &kp PERCENT  &kp CARET             &trans                 &trans      &kp TILDE  &kp COLON      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BACKSLASH  &trans
&mt LEFT_SHIFT MINUS  &kp EXCL       &kp AT       &kp HASH              &trans                 &trans      &trans     &kp SEMICOLON  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp PIPE       &trans
&trans                &trans         &trans       &trans                &trans                 &trans      &trans     &trans                                                                     &trans
            >;
        };

        NUM {
            bindings = <
&kp F1  &kp F2   &kp F3   &kp F4   &trans                      &trans        &kp N7        &kp N8        &kp N9        &kp PLUS
&kp F5  &kp F6   &kp F7   &kp F8   &trans  &trans      &trans  &trans        &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS
&kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans      &trans  &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL
&trans  &trans   &trans   &trans   &trans  &trans      &trans  &trans                                                  &kp PERIOD
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &kp PAGE_UP  &trans  &kp PAGE_DOWN  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB4  &trans    &mkp MB5  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &select_windows  &select_mac  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans           &trans       &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans           &trans       &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                    &bt BT_CLR_ALL
            >;
        };

        MAC_ARROW {
            bindings = <
&trans  &kp LG(LS(TAB))  &trans  &kp LG(TAB)  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans           &trans  &trans       &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans           &trans  &trans       &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans           &trans  &trans       &trans  &trans      &trans  &trans                          &trans
            >;
        };

        WINDOWS_WINDOW {
            bindings = <
&trans  &trans                    &kp LG(UP_ARROW)          &trans                     &trans                      &trans  &trans  &trans  &trans                       &trans
&trans  &kp LG(LEFT_ARROW)        &kp LG(DOWN_ARROW)        &kp LG(RIGHT_ARROW)         &trans  &trans      &trans  &trans  &kp LG(LC(LEFT_ARROW))        &kp LG(TAB)  &kp LG(LC(RIGHT_ARROW))  &trans
&trans  &trans                    &trans                    &trans                     &trans  &trans      &trans  &trans  &trans                       &trans       &trans                    &trans
&trans  &trans                    &trans                    &trans                     &trans  &trans      &trans  &trans                                                       &trans
            >;
        };

        MAC_WINDOW {
            bindings = <
&trans  &trans                    &kp LC(LA(LG(UP_ARROW)))    &trans                       &trans                        &trans  &trans  &trans  &trans                 &trans
&trans  &kp LC(LA(LG(LEFT_ARROW)))  &kp LC(LA(LG(DOWN_ARROW)))  &kp LC(LA(LG(RIGHT_ARROW)))  &trans  &trans      &trans  &trans  &kp LG(LEFT_ARROW)  &kp LG(UP_ARROW)  &kp LG(RIGHT_ARROW)  &trans
&trans  &trans                    &trans                      &trans                       &trans  &trans      &trans  &trans  &trans                 &trans            &trans               &trans
&trans  &trans                    &trans                      &trans                       &trans  &trans      &trans  &trans                                                &trans
            >;
        };

    };
};
